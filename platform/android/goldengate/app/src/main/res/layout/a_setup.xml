<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Androidmeldingen → Fitbit Air"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="v10015: schakel de bridge in om meldingen te ontvangen. Je ziet dan een statusmelding. De app verbindt pas na een melding met je Air, voert het trilpatroon uit en controleert het resultaat. Daarna verbreekt ze de verbinding, zodat Google Health weer kan verbinden." />

            <TextView
                android:id="@+id/selected_device_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#EEEEEE"
                android:padding="10dp"
                android:text="Geselecteerd apparaat: Nog geen Fitbit Air geselecteerd"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/bridge_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bridge inschakelen" />

            <Button
                android:id="@+id/manual_test_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Verbinden en één trilgroep testen" />

            <TextView
                android:id="@+id/last_task_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/black"
                android:padding="10dp"
                android:text="Laatste taak: nog niet uitgevoerd"
                android:textColor="@android:color/white"
                android:textIsSelectable="true"
                android:typeface="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Sms, oproepen, WhatsApp, Messenger en Outlook"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/notification_package_allowlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="com.whatsapp=single"
                android:inputType="textMultiLine|textVisiblePassword"
                android:maxLines="5"
                android:minLines="3"
                android:singleLine="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Je standaard sms- en telefoonapp worden automatisch ingevuld, samen met WhatsApp, Messenger en Outlook (maximaal 5 apps). Herkende inkomende oproepen gebruiken altijd urgent. Eén regel per app: pakketnaam=patroon. Kies single, double, triple, long_gap of urgent." />

            <Button
                android:id="@+id/notification_access_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Regels bewaren en meldingentoegang openen" />

            <TextView
                android:id="@+id/notification_access_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/black"
                android:padding="10dp"
                android:text="Meldingentoegang: nog niet gecontroleerd"
                android:textColor="@android:color/white"
                android:textIsSelectable="true"
                android:typeface="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tijdens een synchronisatie van Google Health wacht de app en probeert ze opnieuw. De trilling kan enkele seconden later komen." />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/start_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:text="Fitbit Air selecteren en bewaren"
        android:textColor="@android:color/white" />
</LinearLayout>
